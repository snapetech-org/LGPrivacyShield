{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/snapetech-org/LGPrivacyShield/blob/main/docs/compatibility-report.schema.json",
  "title": "LGPrivacyShield compatibility report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appVersion", "device", "compatibility", "apiAccess", "controlReads"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "appVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "sdkVersion", "firmwareVersion"],
      "properties": {
        "model": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]{0,63}$" },
        "sdkVersion": { "type": ["string", "null"], "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$" },
        "firmwareVersion": { "type": ["string", "null"], "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "evidenceLevel", "mappingScope", "sampleCount", "mappedControlCount"],
      "properties": {
        "profileId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$" },
        "evidenceLevel": { "enum": ["unmapped", "reported", "source-mapped", "platform-source-mapped", "device-read-verified", "write-readback-verified", "cross-validated"] },
        "mappingScope": { "enum": ["unmapped", "exact-device-firmware", "model-family-platform"] },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "mappedControlCount": { "type": "integer", "minimum": 0, "maximum": 17 }
      }
    },
    "apiAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemInfo", "settingsService", "hbcSnapshot"],
      "properties": {
        "systemInfo": { "type": "boolean" },
        "settingsService": { "enum": ["available", "partial", "unavailable"] },
        "hbcSnapshot": { "type": "boolean" }
      }
    },
    "controlReads": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 17,
      "maxProperties": 17,
      "required": ["livePlus", "voiceLongDistance", "turnOnByVoice", "lmt", "doNotSellMyPersonalInformation", "screenSaverAd", "homePromotion", "livePromotion", "contentRecommendation", "hbbTvDnt", "hbbTvDeviceId", "thirdPartyCookie", "hbbTV", "bleAdvertisingOnOff", "homeSenseAbsence", "aiNudge", "aiSettingsNudge"],
      "properties": {
        "livePlus": { "type": "boolean" },
        "voiceLongDistance": { "type": "boolean" },
        "turnOnByVoice": { "type": "boolean" },
        "lmt": { "type": "boolean" },
        "doNotSellMyPersonalInformation": { "type": "boolean" },
        "screenSaverAd": { "type": "boolean" },
        "homePromotion": { "type": "boolean" },
        "livePromotion": { "type": "boolean" },
        "contentRecommendation": { "type": "boolean" },
        "hbbTvDnt": { "type": "boolean" },
        "hbbTvDeviceId": { "type": "boolean" },
        "thirdPartyCookie": { "type": "boolean" },
        "hbbTV": { "type": "boolean" },
        "bleAdvertisingOnOff": { "type": "boolean" },
        "homeSenseAbsence": { "type": "boolean" },
        "aiNudge": { "type": "boolean" },
        "aiSettingsNudge": { "type": "boolean" }
      }
    }
  }
}
